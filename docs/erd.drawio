<mxfile host="app.diagrams.net" modified="2026-09-16T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="eventhub-erd" name="EventHub ERD">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="users" value="USERS&#xa;PK id: uuid&#xa;UQ email: varchar(255)&#xa;password_hash: varchar(255)&#xa;full_name: varchar(120)&#xa;phone: varchar(30), nullable&#xa;avatar_url: varchar, nullable&#xa;roles: text&#xa;status: varchar&#xa;verified_at: timestamptz, nullable&#xa;created_at / updated_at / version&#xa;IX created_at&#xa;CK email = lower(email)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="290" height="260" as="geometry"/></mxCell>
        <mxCell id="userRefreshTokens" value="USER_REFRESH_TOKENS&#xa;PK id: uuid&#xa;FK user_id → users.id&#xa;UQ token_hash: varchar(64)&#xa;expires_at: timestamptz&#xa;revoked_at: timestamptz, nullable&#xa;created_at / updated_at / version&#xa;IX expires_at&#xa;IX user_id + revoked_at&#xa;ON DELETE CASCADE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="360" width="290" height="210" as="geometry"/></mxCell>
        <mxCell id="eventCategories" value="EVENT_CATEGORIES&#xa;PK id: uuid&#xa;UQ slug: varchar(120)&#xa;name: varchar(100)&#xa;deleted_at: timestamptz, nullable&#xa;created_at / updated_at / version&#xa;IX name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="280" height="160" as="geometry"/></mxCell>
        <mxCell id="events" value="EVENTS&#xa;PK id: uuid&#xa;FK organizer_id → users.id&#xa;FK category_id → categories.id&#xa;UQ slug: varchar(200)&#xa;title: varchar(180)&#xa;description: text&#xa;venue: varchar(255)&#xa;start_at / end_at: timestamptz&#xa;status: varchar&#xa;cover_url / reminder_sent_at, nullable&#xa;created_at / updated_at / version&#xa;IX status + start_at&#xa;IX category_id + status + start_at&#xa;IX organizer_id + created_at&#xa;CK end_at &gt; start_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="360" y="250" width="300" height="330" as="geometry"/></mxCell>
        <mxCell id="eventTicketTypes" value="EVENT_TICKET_TYPES&#xa;PK id: uuid&#xa;FK event_id → events.id&#xa;name: varchar(100)&#xa;price: numeric(12,2)&#xa;capacity: integer&#xa;sold: integer&#xa;created_at / updated_at / version&#xa;UQ event_id + name&#xa;CK price ≥ 0&#xa;CK 0 ≤ sold ≤ capacity&#xa;ON DELETE CASCADE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="710" y="40" width="280" height="250" as="geometry"/></mxCell>
        <mxCell id="eventRegistrations" value="EVENT_REGISTRATIONS&#xa;PK id: uuid&#xa;FK user_id → users.id&#xa;FK event_id → events.id&#xa;status: varchar&#xa;quantity: integer&#xa;total_amount: numeric(12,2)&#xa;idempotency_key: varchar(80)&#xa;cancelled_at: timestamptz, nullable&#xa;created_at / updated_at / version&#xa;UQ user_id + idempotency_key&#xa;IX event_id + status + created_at&#xa;IX user_id + created_at&#xa;CK quantity &gt; 0&#xa;CK total_amount ≥ 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="710" y="350" width="310" height="310" as="geometry"/></mxCell>
        <mxCell id="tickets" value="TICKETS&#xa;PK id: uuid&#xa;FK registration_id → registrations.id&#xa;FK ticket_type_id → ticket_types.id&#xa;UQ qr_token: varchar(64)&#xa;checked_in_at: timestamptz, nullable&#xa;created_at / updated_at / version&#xa;IX registration_id&#xa;IX ticket_type_id&#xa;registration ON DELETE CASCADE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="40" width="310" height="230" as="geometry"/></mxCell>
        <mxCell id="audit" value="AUDIT_LOGS (append-only)&#xa;PK id: uuid&#xa;FK actor_user_id → users.id, nullable&#xa;action: varchar(80)&#xa;target_type: varchar(80)&#xa;target_id: uuid, nullable&#xa;details: jsonb, nullable&#xa;created_at: timestamptz&#xa;IX actor_user_id + created_at&#xa;IX target_type + target_id&#xa;IX created_at&#xa;actor ON DELETE SET NULL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="360" width="310" height="250" as="geometry"/></mxCell>
        <mxCell id="legend" value="Legend: PK = Primary Key | FK = Foreign Key | UQ = Unique | IX = Index | CK = Check Constraint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="360" y="720" width="660" height="40" as="geometry"/></mxCell>
        <mxCell id="e1" value="1:N" edge="1" parent="1" source="users" target="userRefreshTokens"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="organizes 1:N" edge="1" parent="1" source="users" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="1:N" edge="1" parent="1" source="eventCategories" target="events"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="1:N" edge="1" parent="1" source="events" target="eventTicketTypes"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="1:N" edge="1" parent="1" source="events" target="eventRegistrations"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="1:N" edge="1" parent="1" source="users" target="eventRegistrations"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="1:N" edge="1" parent="1" source="eventRegistrations" target="tickets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="1:N" edge="1" parent="1" source="eventTicketTypes" target="tickets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="acts 1:N" edge="1" parent="1" source="users" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
